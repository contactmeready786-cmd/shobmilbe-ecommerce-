{
  // The browser code (shop + admin). `npm run build:client` compiles it to public/js/*.js (ES modules,
  // generated — not kept in git); the pages load them with <script type="module">.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "types": [],
    "strict": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "jsx": "react",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment",
    "rootDir": ".",
    "outDir": "../public/js",
    "noEmitOnError": true,
    "removeComments": false,
    "incremental": false
  },
  "include": ["*.ts", "shop/**/*.ts", "shop/**/*.tsx", "admin/**/*.ts", "admin/**/*.tsx", "i18n/**/*.ts"],
  "exclude": ["sw"]
}
