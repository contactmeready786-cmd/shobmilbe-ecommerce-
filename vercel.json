{
  "framework": null,
  "outputDirectory": "public",
  "regions": [
    "sin1"
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index?__p=$1"
    }
  ],
  "crons": [
    {
      "path": "/api/research/tick",
      "schedule": "7 3 * * *"
    }
  ]
}
