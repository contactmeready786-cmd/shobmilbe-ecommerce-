{
  "name": "shobmilbe-ecommerce",
  "version": "2.0.0",
  "private": true,
  "description": "সবমিলবে — online shop (Next.js, TypeScript, Postgres, Vercel)",
  "scripts": {
    "dev": "npm run build:client && next dev",
    "build:client": "tsc -p client/tsconfig.json && tsc -p client/sw/tsconfig.json",
    "build": "npm run build:client && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit && tsc -p client/tsconfig.json --noEmit && tsc -p client/sw/tsconfig.json --noEmit",
    "test": "SM_STRICT_PIECES=throw tsx --test --test-concurrency=1 tests/*.test.ts tests/*.test.tsx"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@sentry/nextjs": "^11.9.0",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0"
  }
}
