{
  "name": "সবমিলবে Admin",
  "short_name": "সবমিলবে Admin",
  "start_url": "/admin",
  "scope": "/admin",
  "display": "standalone",
  "background_color": "#14213D",
  "theme_color": "#14213D",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "share_target": {
    "action": "/admin/voice/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "files": [
        {
          "name": "audio",
          "accept": [
            "audio/*",
            ".m4a",
            ".amr",
            ".wav",
            ".mp3",
            ".ogg",
            ".opus",
            ".aac",
            ".3gp",
            ".webm"
          ]
        }
      ]
    }
  }
}
